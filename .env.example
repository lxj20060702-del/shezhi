# ---- "她知" 环境变量示例（复制为 .env 或直接在部署平台填环境变量）----
# 大模型（免费方案，任选其一，OpenAI 兼容接口）

# 方案A：智谱 GLM-4-Flash（完全免费）
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_API_KEY=你的智谱APIKey
LLM_MODEL=glm-4-flash

# 方案B：硅基流动 SiliconFlow（有免费模型）
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_API_KEY=你的硅基流动Key
# LLM_MODEL=Qwen/Qwen2.5-7B-Instruct

# 未配置 key 时，系统自动降级为“检索式抽取答案”（不调用大模型，也能演示）
LLM_DISABLED=false
